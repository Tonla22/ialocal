# Local-only server. Do not expose Ollama or open router ports.
APP_ORIGIN=http://127.0.0.1:8765
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
DATABASE_PATH=data/assistant.sqlite3
# Semicolon-separated, explicitly authorized directories. Relative to project.
AUTHORIZED_ROOTS=data/workspace
SESSION_SECURE=false
SESSION_HOURS=12
OLLAMA_TIMEOUT=240
MAX_ITERATIONS=6
# Optional local faster-whisper model directory; never downloaded automatically.
STT_MODEL_PATH=data/models/whisper
VOICE_ENABLED=false
VISION_ENABLED=true
COMPUTER_CONTROL_ENABLED=false
